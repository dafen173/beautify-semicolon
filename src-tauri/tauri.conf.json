{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "productName": "my-app",
  "version": "0.1.0",
  "identifier": "com.myapp.projector",
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "windows": {
      "wix": {
        "template": "<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'><Product Id='*' /></Wix>"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "my-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  }
}
